{
  "name": "zen-todo",
  "displayName": "Zen TODO",
  "description": "Minimal personal TODO list extension: checkbox toggling with cascade/rollup, start/done timestamps, colour coding, and archiving of completed items.",
  "version": "0.1.0",
  "icon": "images/icon.png",
  "license": "MIT",
  "publisher": "josh08h",
  "author": {
    "name": "Josh Hale",
    "email": "hale.j.0810@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/josh08h/zen-todo.git"
  },
  "bugs": {
    "url": "https://github.com/josh08h/zen-todo/issues"
  },
  "homepage": "https://github.com/josh08h/zen-todo#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["todo", "checklist", "task", "productivity"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "todo",
        "aliases": ["TODO", "zen-todo"],
        "extensions": [".todo"],
        "filenames": ["TODO", "todo", "TODO.md", "todo.md"],
        "filenamePatterns": ["TODO", "todo"]
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        "TODO": "todo",
        "todo": "todo",
        "TODO.md": "todo",
        "todo.md": "todo",
        "*.todo": "todo"
      }
    },
    "grammars": [
      {
        "language": "todo",
        "scopeName": "source.todo",
        "path": "./syntax/todo.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "todo.toggle",
        "title": "Zen TODO: Toggle Checkbox"
      },
      {
        "command": "todo.markStarted",
        "title": "Zen TODO: Mark Started"
      },
      {
        "command": "todo.archiveCompleted",
        "title": "Zen TODO: Archive Completed"
      }
    ],
    "keybindings": [
      {
        "command": "todo.toggle",
        "key": "alt+d",
        "mac": "alt+d",
        "when": "editorTextFocus && editorLangId == todo"
      },
      {
        "command": "todo.markStarted",
        "key": "alt+s",
        "mac": "alt+s",
        "when": "editorTextFocus && editorLangId == todo"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "package": "vsce package --out zen-todo.vsix --no-dependencies --no-yarn --no-rewrite-relative-links --allow-missing-repository",
    "reinstall": "bash scripts/reinstall.sh"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "^5.4.0"
  }
}
